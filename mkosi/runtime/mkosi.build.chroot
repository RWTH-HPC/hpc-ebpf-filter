#!/usr/bin/env bash

set -xeuo pipefail

export HOME=/root

source "${HOME}/.cargo/env"

cd "${SRCDIR}/hpc-ebpf-filter"
RUSTFLAGS="--cfg distro=\"${DISTRIBUTION}-${RELEASE}\"" cargo build --release --locked
mkdir -p "${DESTDIR}/usr/local/bin/"
cp target/release/hpc-ebpf-filter "${DESTDIR}/usr/local/bin/"
