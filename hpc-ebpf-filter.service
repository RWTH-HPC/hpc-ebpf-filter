[Unit]
Before=sshd.service
Documentation=https://git-ce.rwth-aachen.de/rwth-software-stack/hpc-ebpf-filter

[Service]
ExecStart=hpc-ebpf-filter
Restart=on-failure

IPAddressDeny=any
PrivateNetwork=yes

ProtectSystem=strict

LockPersonality=yes
MemoryDenyWriteExecute=yes
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
